# Copia este archivo a srcs/.env y rellena tus valores.
# srcs/.env está en .gitignore: no lo subas nunca al repositorio.

# Dominio que sirve NGINX (añádelo a /etc/hosts apuntando a 127.0.0.1)
DOMAIN_NAME=login.42.fr

# MariaDB
MYSQL_HOST=mariadb
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=cambia_esto

# WordPress: el usuario administrador no puede contener «admin»
WP_ADMIN_USER=supervisor
WP_ADMIN_PASSWORD=cambia_esto
WP_ADMIN_EMAIL=supervisor@example.com
WP_USER=editor
WP_USER_PASSWORD=cambia_esto
WP_USER_EMAIL=editor@example.com
